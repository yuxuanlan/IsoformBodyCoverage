params {
    
    // single transcript bed files stored under this directory
    txdir="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/BEDs/trans.0-500"

    // list of transcripts to process by the pipeline
    // this is a list of tx in reference annotation, and also appears in isoquant (detected in sample.)
    txlist="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/trans.0-500.short.list"

    // bam file output from wf-single-cell, after merging bams of all chroms into one
    bamfile="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/pbmc1b_ONT_2026.tagged.bam"

    // unique_read_assignments.tsv from isoquant output, known isoforms (ENST) only 
    infocsv="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/FSM.read2trans.pbmc1b.ENST.short.tsv"

    // these directories will be generated by nextflow
    rseqcout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/rseqc_output"
    moleculeout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/molecules_output"
    genebodyout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/geneBodyCoverage_output"
    emptylistout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/data/MASseq/nanopore/Paper_round2.YL/Software/nf-single_tx_geneBodyCoverage/git/issue_1/ONT.data/emptylist_output"
}

singularity {
    enabled = true
    autoMounts = true
}

executor {
    name='slurm'
    queueSize=200
    pollInterval='2 min'
    queueStatInterval='2 min'
    exitReadTimeout='5 min'
    dumpInterval='2 min'
}

process {
    queue='ei-compute'
    memory='5G'
    cpus = 1
    time = '2h'

    withLabel:singularity_eimap {
        container = "/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/scratch/CB-MAS-Seq_figure_yl/Software/RSeQC/5.0.1_mod/RSeQC_mod.ubuntu.img"
    }

    withName: ExtractMoleculeBam {
        cpus = 4
        queue='ei-compute'
        memory='50G'
        time = '2h'

    }
}

timeline {
  enabled = true
  overwrite = true
}
report {
  enabled = true
  overwrite = true
}
trace {
  enabled = true
  overwrite = true
}

params {
    
    // single transcript bed files stored under this directory
    txdir="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/full_test_version/v1/test/ONT_sample1B/run5/bed.0-500.short"

    // list of transcripts to process by the pipeline
    // this is a list of tx in reference annotation, and also appears in isoquant (detected in sample.)
    txlist="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/full_test_version/v1/test/ONT_sample1B/run5/bed.0-500.short.10.list"

    // bam file output from wf-single-cell, after merging bams of all chroms into one
    bamfile="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/data/Earlham1PBMC_Iain.merged.sorted.bam"

    // unique_read_assignments.tsv from isoquant output, known isoforms (ENST) only 
    infocsv="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/full_test_version/v1/test/ONT_sample1B/run5/unique_read_assignments.ENST.trans.0-500.short.10.tsv"

    rseqcout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/full_test_version/v1/test/ONT_sample1B/run5/rseqc_output"
    moleculeout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/full_test_version/v1/test/ONT_sample1B/run5/molecules_output"
    genebodyout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/full_test_version/v1/test/ONT_sample1B/run5/geneBodyCoverage_output"
    emptylistout="/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/data/results/PBMC_MASseq_YL/nf-single_tx_geneBodyCoverage/paper_scripts/ONT_sample1B/full_test_version/v1/test/ONT_sample1B/run5/emptylist_output"
}

singularity {
    enabled = true
    autoMounts = true
}

executor {
    name='slurm'
    queueSize=200
    pollInterval='2 min'
    queueStatInterval='2 min'
    exitReadTimeout='5 min'
    dumpInterval='2 min'
}

process {
    queue='ei-short'
    memory='5G'
    cpus = 1
    // user needs to compile their own modified version of RSeQC singularity image.
    withLabel:singularity_eimap {
        container = "/ei/projects/f/f4e517e2-faa5-488e-82ef-66c09af5aff9/scratch/CB-MAS-Seq_figure_yl/Software/RSeQC/5.0.1_mod/RSeQC_mod.ubuntu.img"
    }

    withName: ExtractMoleculeBam {
        cpus = 4
        queue='ei-short'
        memory='50G'

    }
}

timeline {
  enabled = true
  overwrite = true
}
report {
  enabled = true
  overwrite = true
}
trace {
  enabled = true
  overwrite = true
}
